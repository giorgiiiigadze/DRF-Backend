# Copy this file to .env and replace values locally. Do not commit .env.
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
OPENAI_API_KEY=replace_with_your_openai_key
OPENAI_MODEL=gpt-4o-mini
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
APPLE_CLIENT_ID=replace_with_apple_bundle_id_or_services_id
